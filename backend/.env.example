# Copy this file to .env and add your own Groq API key.
GROQ_API_KEY=replace_with_your_groq_api_key
# Confirm a currently available tool-calling model in your Groq console.
GROQ_MODEL=openai/gpt-oss-120b
# Comma-separated origins allowed to call this API from a browser.
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Optional. Defaults to ./shopsika.db
# DATABASE_PATH=./shopsika.db
